# The public-facing URL of your backend API (used by the browser)
# Replace this with your Oracle VPS public IP or domain name.
NEXT_PUBLIC_API_URL=http://YOUR_VPS_IP:8000

# The internal Docker network URL (used by Next.js Server Components)
# You only need to change this if you rename the backend service in docker-compose.
INTERNAL_API_URL=http://backend:8000

# The domain name of your frontend that is allowed to talk to the backend.
# Used by the backend CORS configuration.
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-domain.vercel.app
